# 复制为 .env（与 docker-compose.yml 同目录），首次部署前替换所有密码/密钥。
# .env 只保存在服务器上，不要提交到 Git。
COMPOSE_PROJECT_NAME=xiran-platform

# ---- MySQL（仅容器内网可访问，不对外暴露）----
MYSQL_ROOT_PASSWORD=replace-with-long-random-root-password
MYSQL_DB=xiran_platform
MYSQL_USER=xiran
MYSQL_PASSWORD=replace-with-long-random-database-password

# ---- Redis（仅容器内网可访问）----
REDIS_PASSWORD=replace-with-long-random-redis-password

# ---- JWT：至少 32 个字符，可用 `openssl rand -base64 48` 生成 ----
XIRAN_JWT_SECRET=replace-with-at-least-32-random-characters
XIRAN_ACCESS_TOKEN_EXPIRATION=3600000
XIRAN_REFRESH_TOKEN_EXPIRATION=604800000

# ---- CORS：前端走同源 /api，一般留空即可；需要其他域名直接调后端时填写，逗号分隔 ----
XIRAN_CORS_ALLOWED_ORIGINS=

# ---- 前端对外端口（整个栈唯一暴露的端口）----
# 直接对公网提供服务：FRONTEND_BIND=0.0.0.0，FRONTEND_PORT=80
# 前面还有宿主机 Nginx/Caddy 做 HTTPS：FRONTEND_BIND=127.0.0.1，FRONTEND_PORT=8081
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8081

# ---- 后端 JVM 参数（可选）----
JAVA_OPTS=-XX:MaxRAMPercentage=75
