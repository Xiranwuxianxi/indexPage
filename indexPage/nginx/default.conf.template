# 前端容器 Nginx：托管静态站点 + 同源反代 /api 到后端
# 由 nginx 官方镜像在启动时用 envsubst 渲染（仅替换 BACKEND_UPSTREAM）

# 若外层还有 HTTPS 反代，沿用外层传入的 X-Forwarded-*；否则用本层的值
map $http_x_forwarded_proto $xf_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map $http_x_forwarded_host $xf_host {
    default $http_x_forwarded_host;
    ""      $http_host;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;
    server_tokens off;
    # 对外端口可能与容器内 80 不同，重定向一律用相对地址
    absolute_redirect off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    # API 同源反代到后端（保留 /api 前缀）
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $xf_proto;
        proxy_set_header X-Forwarded-Host $xf_host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # 带 hash 的构建产物长期缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # HTML 不缓存，保证发布后立即生效
    location / {
        add_header Cache-Control "no-cache";
        # 优先命中预渲染的 <path>/index.html（不产生 301），否则回退 SPA
        try_files $uri $uri/index.html $uri/ /index.html;
    }
}
