# 后端环境变量示例
# 复制为 .env 后填入真实值，切勿提交到 Git

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=xiran_platform
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥，必须设置足够长的随机字符串
XIRAN_JWT_SECRET=your_super_long_random_secret_key_at_least_32_chars
XIRAN_ACCESS_TOKEN_EXPIRATION=3600000
XIRAN_REFRESH_TOKEN_EXPIRATION=604800000

# GitHub OAuth（Phase 4 配置）
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# MinIO（Phase 5/7 配置）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=xiran-platform
