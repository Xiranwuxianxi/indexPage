# 前端构建镜像：运行时从后端拉取公开内容做 SEO 预渲染，再把 dist 写入共享卷 /site
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# VITE_API_BASE_URL 留空 => 浏览器走同源 /api，由前端容器 Nginx 反代
ENV VITE_API_BASE_URL= \
    VITE_USE_MOCK=false
CMD ["sh", "-c", "npm run build && find /site -mindepth 1 -maxdepth 1 -exec rm -rf {} + && cp -a dist/. /site/"]
